+
+SelectFileResult QtShim::ShowSelectFileDialog(
+    SelectFileDialogType type,
+    const String& title,
+    const String& default_path,
+    int default_filter_index,
+    int num_filters,
+    const String* filter_names,
+    const String* filter_patterns,
+    bool include_all_files) {
+  SelectFileResult result;
+  result.accepted = false;
+  result.filter_index = default_filter_index > 0 ? default_filter_index : 1;
+  result.num_files = 0;
+  result.files = nullptr;
+
+  QFileDialog dialog;
+  dialog.setOption(QFileDialog::DontUseNativeDialog, false);
+  if (title.c_str()) {
+    dialog.setWindowTitle(QString::fromUtf8(title.c_str()));
+  }
+
+  QStringList name_filters;
+  for (int i = 0; i < num_filters; ++i) {
+    QString name =
+        filter_names[i].c_str()
+            ? QString::fromUtf8(filter_names[i].c_str())
+            : QString();
+    QString patterns =
+        filter_patterns[i].c_str()
+            ? QString::fromUtf8(filter_patterns[i].c_str())
+            : QString();
+    if (patterns.isEmpty()) {
+      continue;
+    }
+    if (name.isEmpty()) {
+      name = patterns;
+    } else {
+      name = name + " (" + patterns + ")";
+    }
+    // QFileDialog expects patterns separated by spaces inside the
+    // parenthesized section of "Name (*.ext1 *.ext2)".
+    name_filters << name;
+  }
+  if (include_all_files && !name_filters.isEmpty()) {
+    name_filters << QStringLiteral("All Files (*)");
+  }
+  if (!name_filters.isEmpty()) {
+    dialog.setNameFilters(name_filters);
+    int filter_idx = default_filter_index - 1;
+    if (filter_idx >= 0 && filter_idx < name_filters.size()) {
+      dialog.selectNameFilter(name_filters.at(filter_idx));
+    }
+  }
+
+  QString start_path =
+      default_path.c_str() ? QString::fromUtf8(default_path.c_str())
+                           : QString();
+
+  switch (type) {
+    case SelectFileDialogType::kOpenFile:
+      dialog.setFileMode(QFileDialog::ExistingFile);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case SelectFileDialogType::kOpenMultiFile:
+      dialog.setFileMode(QFileDialog::ExistingFiles);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case SelectFileDialogType::kSaveFile:
+      dialog.setFileMode(QFileDialog::AnyFile);
+      dialog.setAcceptMode(QFileDialog::AcceptSave);
+      dialog.setOption(QFileDialog::DontConfirmOverwrite, false);
+      break;
+    case SelectFileDialogType::kFolder:
+    case SelectFileDialogType::kUploadFolder:
+      dialog.setFileMode(QFileDialog::Directory);
+      dialog.setOption(QFileDialog::ShowDirsOnly, true);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case SelectFileDialogType::kExistingFolder:
+      dialog.setFileMode(QFileDialog::Directory);
+      dialog.setOption(QFileDialog::ShowDirsOnly, true);
+      dialog.setOption(QFileDialog::ReadOnly, true);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+  }
+
+  if (!start_path.isEmpty()) {
+    // If the path looks like a file, set directory + selected file.
+    QFileInfo info(start_path);
+    if (info.isDir()) {
+      dialog.setDirectory(start_path);
+    } else {
+      dialog.setDirectory(info.absolutePath());
+      if (type == SelectFileDialogType::kSaveFile ||
+          type == SelectFileDialogType::kOpenFile) {
+        dialog.selectFile(info.fileName());
+      }
+    }
+  }
+
+  if (dialog.exec() != QDialog::Accepted) {
+    return result;
+  }
+
+  QStringList selected = dialog.selectedFiles();
+  if (selected.isEmpty()) {
+    return result;
+  }
+
+  result.accepted = true;
+  result.num_files = selected.size();
+  result.files =
+      static_cast<char**>(malloc(sizeof(char*) * result.num_files));
+  for (int i = 0; i < result.num_files; ++i) {
+    QByteArray utf8 = selected.at(i).toUtf8();
+    result.files[i] = strdup(utf8.constData());
+  }
+
+  // Map selected name filter back to a 1-based index among the filters we
+  // added (excluding the synthetic "All Files" entry when present).
+  if (!name_filters.isEmpty()) {
+    QString selected_filter = dialog.selectedNameFilter();
+    int idx = name_filters.indexOf(selected_filter);
+    if (idx >= 0) {
+      // If include_all_files added a trailing filter and that was chosen,
+      // report the last real filter (or 1) rather than inventing an index
+      // beyond Chromium's FileTypeInfo.
+      if (include_all_files && idx == name_filters.size() - 1 &&
+          num_filters > 0) {
+        result.filter_index = num_filters;
+      } else {
+        result.filter_index = idx + 1;
+      }
+    }
+  }
+
+  return result;
 }
 
 }  // namespace qt
