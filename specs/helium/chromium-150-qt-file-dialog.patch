 ui::SelectFileDialog* QtUi::CreateSelectFileDialog(
     void* listener,
     std::unique_ptr<ui::SelectFilePolicy> policy) const {
+  // Prefer a native Qt file dialog so Qt-based hosts (and CEF embeds without
+  // GTK) work when XDG Desktop Portal is unavailable. Only fall back to the
+  // GTK LinuxUi path if the Qt shim failed to load.
+  if (shim_) {
+    return new SelectFileDialogLinuxQt(
+        static_cast<ui::SelectFileDialog::Listener*>(listener),
+        std::move(policy), shim_.get());
+  }
   return fallback_linux_ui_ ? fallback_linux_ui_->CreateSelectFileDialog(
                                   listener, std::move(policy))
                             : nullptr;
