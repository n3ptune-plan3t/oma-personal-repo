+
+SelectFileDialogType ToQtType(ui::SelectFileDialog::Type type) {
+  switch (type) {
+    case ui::SelectFileDialog::SELECT_OPEN_FILE:
+      return SelectFileDialogType::kOpenFile;
+    case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE:
+      return SelectFileDialogType::kOpenMultiFile;
+    case ui::SelectFileDialog::SELECT_SAVEAS_FILE:
+      return SelectFileDialogType::kSaveFile;
+    case ui::SelectFileDialog::SELECT_FOLDER:
+      return SelectFileDialogType::kFolder;
+    case ui::SelectFileDialog::SELECT_EXISTING_FOLDER:
+      return SelectFileDialogType::kExistingFolder;
+    case ui::SelectFileDialog::SELECT_UPLOAD_FOLDER:
+      return SelectFileDialogType::kUploadFolder;
+    case ui::SelectFileDialog::SELECT_NONE:
+      break;
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
+SelectFileDialogLinuxQt::SelectFileDialogLinuxQt(
+    Listener* listener,
+    std::unique_ptr<ui::SelectFilePolicy> policy,
+    QtInterface* shim)
+    : SelectFileDialogLinux(listener, std::move(policy)), shim_(shim) {
+  DCHECK(shim_);
+}
+
+SelectFileDialogLinuxQt::~SelectFileDialogLinuxQt() = default;
+
+bool SelectFileDialogLinuxQt::IsRunning(
+    gfx::NativeWindow /*parent_window*/) const {
+  return is_running_;
+}
+
+bool SelectFileDialogLinuxQt::HasMultipleFileTypeChoicesImpl() {
+  return file_types().extensions.size() > 1;
+}
+
+DISABLE_CFI_VCALL
+void SelectFileDialogLinuxQt::SelectFileImpl(
+    Type type,
+    const std::u16string& title,
+    const base::FilePath& default_path,
+    const FileTypeInfo* file_types,
+    int file_type_index,
+    const base::FilePath::StringType& /*default_extension*/,
+    gfx::NativeWindow /*owning_window*/,
+    const GURL* /*caller*/) {
+  set_type(type);
+  set_file_type_index(file_type_index);
+  if (file_types) {
+    set_file_types(*file_types);
+  }
+  // Use the stored FileTypeInfo after set_file_types(); avoid shadowing the
+  // file_types() accessor with the parameter name.
+  const FileTypeInfo& stored_types = this->file_types();
+
+  std::string title_string = base::UTF16ToUTF8(title);
+  if (title_string.empty()) {
+    switch (type) {
+      case SELECT_UPLOAD_FOLDER:
+        title_string =
+            l10n_util::GetStringUTF8(IDS_SELECT_UPLOAD_FOLDER_DIALOG_TITLE);
+        break;
+      case SELECT_FOLDER:
+      case SELECT_EXISTING_FOLDER:
+        title_string = l10n_util::GetStringUTF8(IDS_SELECT_FOLDER_DIALOG_TITLE);
+        break;
+      default:
+        break;
+    }
+  }
+
+  base::FilePath path = default_path;
+  if (path.empty()) {
+    if (type == SELECT_SAVEAS_FILE && !last_saved_path()->empty()) {
+      path = *last_saved_path();
+    } else if (!last_opened_path()->empty()) {
+      path = *last_opened_path();
+    }
+  }
+
+  // Build filter arrays for the Qt shim boundary.
+  const size_t num_filters = stored_types.extensions.size();
+  std::vector<String> filter_names;
+  std::vector<String> filter_patterns;
+  filter_names.reserve(num_filters);
+  filter_patterns.reserve(num_filters);
+
+  for (size_t i = 0; i < num_filters; ++i) {
+    std::string patterns;
+    for (const auto& ext : stored_types.extensions[i]) {
+      if (ext.empty()) {
+        continue;
+      }
+      if (!patterns.empty()) {
+        patterns.push_back(' ');
+      }
+      patterns.append("*.");
+      patterns.append(base::ToLowerASCII(ext));
+    }
+    if (patterns.empty()) {
+      // Keep a placeholder so indices stay aligned; empty patterns are
+      // skipped by the shim.
+      filter_names.emplace_back();
+      filter_patterns.emplace_back();
+      continue;
+    }
+
+    std::string name;
+    if (i < stored_types.extension_description_overrides.size()) {
+      name = base::UTF16ToUTF8(
+          stored_types.extension_description_overrides[i]);
+    }
+    filter_names.emplace_back(name.empty() ? nullptr : name.c_str());
+    filter_patterns.emplace_back(patterns.c_str());
+  }
+
+  is_running_ = true;
+  SelectFileResult result = shim_->ShowSelectFileDialog(
+      ToQtType(type), String(title_string.empty() ? nullptr : title_string.c_str()),
+      String(path.empty() ? nullptr : path.value().c_str()), file_type_index,
+      static_cast<int>(filter_names.size()),
+      filter_names.empty() ? nullptr : filter_names.data(),
+      filter_patterns.empty() ? nullptr : filter_patterns.data(),
+      stored_types.include_all_files);
+  is_running_ = false;
+
+  if (!result.accepted || result.num_files <= 0 || !result.files) {
+    if (result.files) {
+      for (int i = 0; i < result.num_files; ++i) {
+        free(result.files[i]);
+      }
+      free(result.files);
+    }
+    if (listener_) {
+      listener_->FileSelectionCanceled();
+    }
+    return;
+  }
+
+  std::vector<base::FilePath> paths;
+  paths.reserve(result.num_files);
+  for (int i = 0; i < result.num_files; ++i) {
+    if (result.files[i]) {
+      paths.emplace_back(result.files[i]);
+      free(result.files[i]);
+    }
+  }
+  free(result.files);
+
+  if (paths.empty()) {
+    if (listener_) {
+      listener_->FileSelectionCanceled();
+    }
+    return;
+  }
+
+  if (type == SELECT_SAVEAS_FILE) {
+    set_last_saved_path(paths[0].DirName());
+  } else {
+    set_last_opened_path(paths[0].DirName());
+  }
+
+  if (!listener_) {
+    return;
+  }
+
+  if (type == SELECT_OPEN_MULTI_FILE) {
+    listener_->MultiFilesSelected(
+        ui::FilePathListToSelectedFileInfoList(paths));
+  } else {
+    listener_->FileSelected(ui::SelectedFileInfo(paths[0]),
+                            result.filter_index);
+  }
+}
+
+}  // namespace qt
