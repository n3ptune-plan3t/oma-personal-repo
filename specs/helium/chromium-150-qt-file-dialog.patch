+// Implementation of SelectFileDialog that shows a Qt QFileDialog for choosing
+// a file or folder. Used when XDG Desktop Portal is unavailable and the Qt
+// Linux UI backend is active (so we do not need a GTK fallback).
+class SelectFileDialogLinuxQt : public ui::SelectFileDialogLinux {
+ public:
+  SelectFileDialogLinuxQt(Listener* listener,
+                          std::unique_ptr<ui::SelectFilePolicy> policy,
+                          QtInterface* shim);
+
+  SelectFileDialogLinuxQt(const SelectFileDialogLinuxQt&) = delete;
+  SelectFileDialogLinuxQt& operator=(const SelectFileDialogLinuxQt&) = delete;
+
+ protected:
+  ~SelectFileDialogLinuxQt() override;
+
+  // BaseShellDialog:
+  bool IsRunning(gfx::NativeWindow parent_window) const override;
+
+  // SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override;
+
+ private:
+  bool HasMultipleFileTypeChoicesImpl() override;
+
+  raw_ptr<QtInterface> shim_;
+  bool is_running_ = false;
+};
+
