+std::string CrashReportProcessType(const std::string& local_id) {
+  crashpad::CrashReportDatabase* database =
+      crash_reporter::internal::GetCrashReportDatabase();
+  if (!database) {
+    return std::string();
+  }
+
+  crashpad::UUID uuid;
+  if (!uuid.InitializeFromString(local_id)) {
+    return std::string();
+  }
+
+  crashpad::CrashReportDatabase::Report report;
+  if (database->LookUpCrashReport(uuid, &report) !=
+      crashpad::CrashReportDatabase::kNoError) {
+    return std::string();
+  }
+
+  crashpad::FileReader reader;
+  if (!reader.Open(report.file_path)) {
+    return std::string();
+  }
+
+  crashpad::ProcessSnapshotMinidump snapshot;
+  if (!snapshot.Initialize(&reader)) {
+    return std::string();
+  }
+
+  const auto& annotations = snapshot.AnnotationsSimpleMap();
+  const auto it = annotations.find("ptype");
+  return it == annotations.end() ? std::string() : it->second;
+}
+
 }  // namespace
 
+bool IsGpuProcessCrashReport(const std::string& local_id) {
+  return CrashReportProcessType(local_id) == "gpu-process";
+}
+
+void DiscardPendingGpuProcessCrashReports() {
+  std::vector<crash_reporter::Report> reports;
+  crash_reporter::GetReports(&reports);
+  for (const auto& report : reports) {
+    if (report.state != crash_reporter::ReportUploadState::Pending &&
+        report.state !=
+            crash_reporter::ReportUploadState::Pending_UserRequested) {
+      continue;
+    }
+    if (IsGpuProcessCrashReport(report.local_id)) {
+      crash_reporter::DeleteCrashReport(report.local_id);
+    }
+  }
+}
