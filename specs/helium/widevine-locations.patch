description: try alternative locations for libwidevinecdm.so
  - $HOME/.local/lib/ (snap-friendly, see https://launchpad.net/bugs/1738149)
author: Olivier Tilloy <olivier.tilloy@canonical.com>

diff -urN a/chrome/common/chrome_paths.cc b/chrome/common/chrome_paths.cc
--- a/chrome/common/chrome_paths.cc	2026-08-02 00:59:09.160805641 +0200
+++ b/chrome/common/chrome_paths.cc	2026-08-02 00:59:09.160844841 +0200
@@ -313,6 +313,11 @@
 
 #if BUILDFLAG(ENABLE_WIDEVINE)
     case chrome::DIR_BUNDLED_WIDEVINE_CDM:
+      base::PathService::Get(base::DIR_HOME, &cur);
+      cur = cur.Append(FILE_PATH_LITERAL(".local/lib/libwidevinecdm.so"));
+      if (base::PathExists(cur)) {
+        break;
+      }
       if (!GetComponentDirectory(&cur)) {
         return false;
       }
diff -urN a/third_party/widevine/cdm/BUILD.gn b/third_party/widevine/cdm/BUILD.gn
--- a/third_party/widevine/cdm/BUILD.gn	2026-08-02 00:59:09.160876652 +0200
+++ b/third_party/widevine/cdm/BUILD.gn	2026-08-02 00:59:09.160902042 +0200
@@ -19,7 +19,7 @@
 
   flags = [
     "ENABLE_WIDEVINE=$enable_widevine",
-    "BUNDLE_WIDEVINE_CDM=$bundle_widevine_cdm",
+    "BUNDLE_WIDEVINE_CDM=true",
     "ENABLE_WIDEVINE_CDM_COMPONENT=$enable_widevine_cdm_component",
   ]
 }
