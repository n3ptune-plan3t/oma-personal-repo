+PrintingSettings PrintSettingsFromPrinter(const QPrinter& printer) {
+  PrintingSettings settings;
+  settings.printer_name =
+      String(printer.printerName().toStdString().c_str());
+  settings.dpi = printer.resolution();
+  settings.copies = printer.copyCount();
+  settings.collate = printer.collateCopies();
+  settings.landscape =
+      printer.pageLayout().orientation() == QPageLayout::Landscape;
+
+  QRectF paper_rect =
+      printer.pageLayout().fullRect(QPageLayout::Inch);
+  settings.page_width_inches = paper_rect.width();
+  settings.page_height_inches = paper_rect.height();
+
+  QMarginsF margins =
+      printer.pageLayout().margins(QPageLayout::Inch);
+  settings.margin_left_inches = margins.left();
+  settings.margin_top_inches = margins.top();
+
+  QRectF printable_rect =
+      printer.pageLayout().paintRect(QPageLayout::Inch);
+  settings.printable_width_inches = printable_rect.width();
+  settings.printable_height_inches = printable_rect.height();
+  return settings;
+}
+
+void QtShim::GetDefaultPaperSize(float* width_inches,
+                                 float* height_inches) const {
+  QPrinter printer;
+  QRectF paper_rect =
+      printer.pageLayout().fullRect(QPageLayout::Inch);
+  *width_inches = paper_rect.width();
+  *height_inches = paper_rect.height();
+}
+
+PrintingSettings QtShim::GetDefaultPrintSettings() const {
+  QPrinter printer;
+  return PrintSettingsFromPrinter(printer);
+}
+
+PrintingSettings QtShim::GetPrinterSettings(
+    const String& printer_name) const {
+  QPrinterInfo info =
+      QPrinterInfo::printerInfo(QString::fromUtf8(printer_name.c_str()));
+  if (info.isNull()) {
+    return GetDefaultPrintSettings();
+  }
+  QPrinter printer(info);
+  return PrintSettingsFromPrinter(printer);
+}
+
+PrintDialogResult QtShim::ShowPrintDialog(bool has_selection) {
+  PrintDialogResult result;
+  result.accepted = false;
+  result.selection_only = false;
+  result.num_ranges = 0;
+  result.ranges = nullptr;
+
+  QPrinter printer(QPrinter::HighResolution);
+  QPrintDialog dialog(&printer);
+  dialog.setOption(QAbstractPrintDialog::PrintPageRange, true);
+  if (has_selection) {
+    dialog.setOption(QAbstractPrintDialog::PrintSelection, true);
+  }
+
+  if (dialog.exec() != QDialog::Accepted) {
+    return result;
+  }
+
+  result.accepted = true;
+  result.selection_only =
+      dialog.printRange() == QAbstractPrintDialog::Selection;
+  result.settings = PrintSettingsFromPrinter(printer);
+
+  if (dialog.printRange() == QAbstractPrintDialog::PageRange) {
+    result.num_ranges = 1;
+    result.ranges =
+        static_cast<PrintRange*>(malloc(sizeof(PrintRange)));
+    result.ranges[0].from = dialog.fromPage() - 1;
+    result.ranges[0].to = dialog.toPage() - 1;
+  }
+
+  return result;
+}
+
 }  // namespace qt
 
