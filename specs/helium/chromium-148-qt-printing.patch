+  int to;
+};
+
+// Result of showing a print dialog.
+struct PrintDialogResult {
+  bool accepted = false;
+  bool selection_only = false;
+  PrintingSettings settings;
+  int num_ranges = 0;
+  // Allocated with malloc(), caller must free().
+  PrintRange* ranges = nullptr;
+};
