+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/qt/printing/printing_qt_util.h"
+
+#include <string>
+
+#include "base/strings/utf_string_conversions.h"
+#include "printing/print_settings.h"
+#include "printing/units.h"
+#include "ui/gfx/geometry/size.h"
+
+void InitPrintSettingsQt(const qt::PrintingSettings& qt_settings,
+                         printing::PrintSettings* print_settings) {
+  DCHECK(print_settings);
+
+  const char* printer_name = qt_settings.printer_name.c_str();
+  std::u16string name =
+      printer_name ? base::UTF8ToUTF16(printer_name) : std::u16string();
+  print_settings->set_device_name(name);
+
+  int dpi = qt_settings.dpi;
+  if (dpi <= 0) {
+    dpi = printing::kDefaultPdfDpi;
+  }
+
+  gfx::Size physical_size_device_units;
+  gfx::Rect printable_area_device_units;
+
+  physical_size_device_units.SetSize(
+      qt_settings.page_width_inches * dpi,
+      qt_settings.page_height_inches * dpi);
+
+  printable_area_device_units.SetRect(
+      qt_settings.margin_left_inches * dpi,
+      qt_settings.margin_top_inches * dpi,
+      qt_settings.printable_width_inches * dpi,
+      qt_settings.printable_height_inches * dpi);
+
+  print_settings->set_dpi(dpi);
+  print_settings->SetOrientation(qt_settings.landscape);
+  DCHECK_EQ(print_settings->device_units_per_inch(), dpi);
+  print_settings->SetPrinterPrintableArea(physical_size_device_units,
+                                          printable_area_device_units, true);
+}
+
+DISABLE_CFI_VCALL
+gfx::Size GetPdfPaperSizeDeviceUnitsQt(qt::QtInterface* shim,
+                                        int device_units_per_inch) {
+  float width_inches = 0;
+  float height_inches = 0;
+  shim->GetDefaultPaperSize(&width_inches, &height_inches);
+  return gfx::Size(width_inches * device_units_per_inch,
+                   height_inches * device_units_per_inch);
+}
