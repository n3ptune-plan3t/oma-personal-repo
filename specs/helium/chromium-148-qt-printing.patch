+++ b/ui/qt/printing/print_dialog_qt.cc
@@ -0,0 +1,246 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/qt/printing/print_dialog_qt.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "printing/buildflags/buildflags.h"
+#include "printing/metafile.h"
+#include "printing/mojom/print.mojom.h"
+#include "printing/print_job_constants.h"
+#include "printing/print_settings.h"
+#include "ui/qt/printing/printing_qt_util.h"
+
+#if BUILDFLAG(USE_CUPS)
+#include <cups/cups.h>
+#endif
+
+using printing::PageRanges;
+using printing::PrintSettings;
+
+PrintDialogQt::PrintDialogQt(PrintingContextLinux* context,
+                             qt::QtInterface* shim)
+    : context_(context),
+      shim_(shim),
+      task_runner_(base::SequencedTaskRunner::GetCurrentDefault()) {}
+
+PrintDialogQt::~PrintDialogQt() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+DISABLE_CFI_VCALL
+void PrintDialogQt::UseDefaultSettings() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  qt::PrintingSettings qt_settings = shim_->GetDefaultPrintSettings();
+  printer_name_ =
+      qt_settings.printer_name.c_str() ? qt_settings.printer_name.c_str() : "";
+  copies_ = qt_settings.copies;
+  collate_ = qt_settings.collate;
+  landscape_ = qt_settings.landscape;
+
+  auto settings = std::make_unique<PrintSettings>();
+  InitPrintSettings(std::move(settings), qt_settings);
+}
+
+DISABLE_CFI_VCALL
+void PrintDialogQt::UpdateSettings(
+    std::unique_ptr<printing::PrintSettings> settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  std::string printer_name = base::UTF16ToUTF8(settings->device_name());
+  qt::PrintingSettings qt_settings =
+      shim_->GetPrinterSettings(qt::String(printer_name.c_str()));
+
+  // Apply requested settings that may differ from the printer defaults.
+  qt_settings.copies = settings->copies();
+  qt_settings.collate = settings->collate();
+  qt_settings.landscape = settings->landscape();
+  if (settings->dpi_horizontal() > 0) {
+    qt_settings.dpi = settings->dpi_horizontal();
+  }
+
+  printer_name_ =
+      qt_settings.printer_name.c_str() ? qt_settings.printer_name.c_str() : "";
+  copies_ = qt_settings.copies;
+  collate_ = qt_settings.collate;
+  landscape_ = qt_settings.landscape;
+
+  InitPrintSettings(std::move(settings), qt_settings);
+}
+
+#if BUILDFLAG(ENABLE_OOP_PRINTING_NO_OOP_BASIC_PRINT_DIALOG)
+DISABLE_CFI_VCALL
+void PrintDialogQt::LoadPrintSettings(const PrintSettings& settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  const std::string* stored_printer_name =
+      settings.system_print_dialog_data().FindString(
+          printing::kLinuxSystemPrintDialogDataPrinter);
+  if (stored_printer_name) {
+    printer_name_ = *stored_printer_name;
+    qt::PrintingSettings qt_settings =
+        shim_->GetPrinterSettings(qt::String(stored_printer_name->c_str()));
+    // Apply the settings we stored; no further Chrome-level reconciliation
+    // is needed because the printer settings already match the original
+    // dialog output.
+    auto new_settings = std::make_unique<PrintSettings>(settings);
+    InitPrintSettings(std::move(new_settings), qt_settings);
+  }
+}
+#endif  // BUILDFLAG(ENABLE_OOP_PRINTING_NO_OOP_BASIC_PRINT_DIALOG)
+
+DISABLE_CFI_VCALL
+void PrintDialogQt::ShowDialog(
+    gfx::NativeView parent_view,
+    bool has_selection,
+    PrintingContextLinux::PrintSettingsCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  qt::PrintDialogResult result = shim_->ShowPrintDialog(has_selection);
+
+  if (!result.accepted) {
+    std::move(callback).Run(printing::mojom::ResultCode::kCanceled);
+    return;
+  }
+
+  if (!context_) {
+    std::move(callback).Run(printing::mojom::ResultCode::kCanceled);
+    return;
+  }
+
+  printer_name_ = result.settings.printer_name.c_str()
+                       ? result.settings.printer_name.c_str()
+                       : "";
+  copies_ = result.settings.copies;
+  collate_ = result.settings.collate;
+  landscape_ = result.settings.landscape;
+
+  // Handle page ranges.
+  PageRanges ranges_vector;
+  if (!result.selection_only && result.num_ranges > 0 && result.ranges) {
+    for (int i = 0; i < result.num_ranges; ++i) {
+      printing::PageRange range;
+      range.from = result.ranges[i].from;
+      range.to = result.ranges[i].to;
+      ranges_vector.push_back(range);
+    }
+  }
+  free(result.ranges);
+  result.ranges = nullptr;
+
+  auto settings = std::make_unique<PrintSettings>();
+  settings->set_is_modifiable(context_->settings().is_modifiable());
+  settings->set_ranges(ranges_vector);
+  settings->set_selection_only(result.selection_only);
+
+  InitPrintSettings(std::move(settings), result.settings);
+  std::move(callback).Run(printing::mojom::ResultCode::kSuccess);
+}
+
+void PrintDialogQt::PrintDocument(const printing::MetafilePlayer& metafile,
+                                  const std::u16string& document_name) {
+  bool success = base::CreateTemporaryFile(&path_to_pdf_);
+
+  if (success) {
+    base::File file;
+    file.Initialize(path_to_pdf_,
+                    base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    success = metafile.SaveTo(&file);
+    file.Close();
+    if (!success) {
+      base::DeleteFile(path_to_pdf_);
+    }
+  }
+
+  if (!success) {
+    LOG(ERROR) << "Saving metafile failed";
+    return;
+  }
+
+  // Continue printing on the UI thread.
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&PrintDialogQt::SendDocumentToPrinter,
+                                weak_factory_.GetWeakPtr(), document_name));
+}
+
+void PrintDialogQt::SendDocumentToPrinter(
+    const std::u16string& document_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (printer_name_.empty()) {
+    LOG(ERROR) << "Printing failed: no printer selected";
+    base::ThreadPool::PostTask(FROM_HERE,
+                               {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+                                base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+                               base::GetDeleteFileCallback(path_to_pdf_));
+    return;
+  }
+
+#if BUILDFLAG(USE_CUPS)
+  std::string title = base::UTF16ToUTF8(document_name);
+
+  int num_options = 0;
+  cups_option_t* options = nullptr;
+
+  std::string copies_str = base::NumberToString(copies_);
+  num_options =
+      cupsAddOption("copies", copies_str.c_str(), num_options, &options);
+  num_options = cupsAddOption("collate", collate_ ? "true" : "false",
+                              num_options, &options);
+  if (landscape_) {
+    num_options =
+        cupsAddOption("landscape", "true", num_options, &options);
+  }
+
+  int job_id = cupsPrintFile(printer_name_.c_str(),
+                             path_to_pdf_.value().c_str(), title.c_str(),
+                             num_options, options);
+
+  cupsFreeOptions(num_options, options);
+
+  if (job_id == 0) {
+    LOG(ERROR) << "CUPS printing failed: " << cupsLastErrorString();
+  }
+#else
+  LOG(ERROR) << "Printing is not supported without CUPS";
+#endif
+
+  base::ThreadPool::PostTask(FROM_HERE,
+                             {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+                              base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+                             base::GetDeleteFileCallback(path_to_pdf_));
+}
+
+void PrintDialogQt::InitPrintSettings(
+    std::unique_ptr<PrintSettings> settings,
+    const qt::PrintingSettings& qt_settings) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!context_) {
+    return;
+  }
+
+  InitPrintSettingsQt(qt_settings, settings.get());
+
+#if BUILDFLAG(ENABLE_OOP_PRINTING_NO_OOP_BASIC_PRINT_DIALOG)
+  if (qt_settings.printer_name.c_str()) {
+    base::DictValue dialog_data;
+    dialog_data.Set(printing::kLinuxSystemPrintDialogDataPrinter,
+                    std::string(qt_settings.printer_name.c_str()));
+    settings->set_system_print_dialog_data(std::move(dialog_data));
+  }
+#endif
+
+  context_->InitWithSettings(std::move(settings));
+}
