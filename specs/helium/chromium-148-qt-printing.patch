+// Printing settings exchanged across the shim boundary.
+struct PrintingSettings {
+  String printer_name;
+  int dpi = 0;
+  int copies = 1;
+  bool collate = false;
+  bool landscape = false;
+  // Physical page dimensions in inches.
+  float page_width_inches = 0;
+  float page_height_inches = 0;
+  // Margins in inches.
+  float margin_left_inches = 0;
+  float margin_top_inches = 0;
+  // Printable area dimensions in inches.
