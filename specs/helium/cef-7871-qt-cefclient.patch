+RootWindowQt::RootWindowQt(bool use_alloy_style)
+    : RootWindow(use_alloy_style) {}
+
+RootWindowQt::~RootWindowQt() {
+  REQUIRE_MAIN_THREAD();
+  DCHECK(window_destroyed_);
+  DCHECK(browser_destroyed_);
+}
+
+void RootWindowQt::Init(RootWindow::Delegate* delegate,
+                        std::unique_ptr<RootWindowConfig> config,
+                        const CefBrowserSettings& settings) {
+  DCHECK(delegate);
+  DCHECK(!initialized_);
+
+  delegate_ = delegate;
+  with_controls_ = config->with_controls;
+  always_on_top_ = config->always_on_top;
+  with_osr_ = config->with_osr;
+
+  if (with_osr_) {
+    LOG(WARNING) << "OSR is not implemented in the Qt sample; "
+                    "using a windowed browser instead.";
+    with_osr_ = false;
+  }
+
+  CreateBrowserWindow(config->url);
+
+  if (CefCurrentlyOn(TID_UI)) {
+    ContinueInitOnUIThread(std::move(config), settings);
+  } else {
+    CefPostTask(TID_UI, base::BindOnce(&RootWindowQt::ContinueInitOnUIThread,
+                                       this, std::move(config), settings));
+  }
+}
+
+void RootWindowQt::ContinueInitOnUIThread(
+    std::unique_ptr<RootWindowConfig> config,
+    const CefBrowserSettings& settings) {
+  CEF_REQUIRE_UI_THREAD();
+
+  if (!config->bounds.IsEmpty()) {
+    start_rect_ = config->bounds;
+    initial_show_state_ = config->show_state;
+  }
+
+  if (CURRENTLY_ON_MAIN_THREAD()) {
+    ContinueInitOnMainThread(std::move(config), settings);
+  } else {
+    MAIN_POST_CLOSURE(base::BindOnce(&RootWindowQt::ContinueInitOnMainThread,
+                                     this, std::move(config), settings));
+  }
+}
+
+void RootWindowQt::ContinueInitOnMainThread(
+    std::unique_ptr<RootWindowConfig> config,
+    const CefBrowserSettings& settings) {
+  REQUIRE_MAIN_THREAD();
+
+  initialized_ = true;
+  MAIN_POST_CLOSURE(base::BindOnce(&RootWindowQt::CreateRootWindow, this,
+                                   settings, config->initially_hidden));
+}
+
+void RootWindowQt::InitAsPopup(RootWindow::Delegate* delegate,
+                               bool with_controls,
+                               bool with_osr,
+                               const CefPopupFeatures& popupFeatures,
+                               CefWindowInfo& windowInfo,
+                               CefRefPtr<CefClient>& client,
+                               CefBrowserSettings& settings) {
+  CEF_REQUIRE_UI_THREAD();
+
+  DCHECK(delegate);
+  DCHECK(!initialized_);
+
+  delegate_ = delegate;
+  with_controls_ = with_controls;
+  with_osr_ = false;  // Qt sample: windowed only.
+  is_popup_ = true;
+
+  if (popupFeatures.xSet) {
+    start_rect_.x = popupFeatures.x;
+  }
+  if (popupFeatures.ySet) {
+    start_rect_.y = popupFeatures.y;
+  }
+  if (popupFeatures.widthSet) {
+    start_rect_.width = popupFeatures.width;
+  }
+  if (popupFeatures.heightSet) {
+    start_rect_.height = popupFeatures.height;
+  }
+
+  CreateBrowserWindow(std::string());
+  initialized_ = true;
+
+  browser_window_->GetPopupConfig(TempWindow::GetWindowHandle(), windowInfo,
+                                  client, settings);
+}
+
+void RootWindowQt::Show(ShowMode mode) {
+  REQUIRE_MAIN_THREAD();
+  if (!window_) {
+    return;
+  }
+
+  window_->show();
+  if (mode == ShowMinimized) {
+    window_->showMinimized();
+  } else if (mode == ShowMaximized) {
+    window_->showMaximized();
+  } else {
+    window_->showNormal();
+  }
+  window_->raise();
+  window_->activateWindow();
+}
+
+void RootWindowQt::Hide() {
+  REQUIRE_MAIN_THREAD();
+  if (window_) {
+    window_->hide();
+  }
+}
+
+void RootWindowQt::SetBounds(int x,
+                             int y,
+                             size_t width,
+                             size_t height,
+                             bool /*content_bounds*/) {
+  REQUIRE_MAIN_THREAD();
+  if (!window_) {
+    return;
+  }
+  window_->setGeometry(x, y, static_cast<int>(width), static_cast<int>(height));
+}
+
+bool RootWindowQt::DefaultToContentBounds() const {
+  // Windowed browser bounds come from GetRootWindowScreenRect.
+  return false;
+}
+
+void RootWindowQt::Close(bool force) {
+  REQUIRE_MAIN_THREAD();
+  if (window_) {
+    if (force) {
+      NotifyForceClose();
+    }
+    window_->close();
+  }
+}
+
+void RootWindowQt::SetDeviceScaleFactor(float /*device_scale_factor*/) {
+  REQUIRE_MAIN_THREAD();
+  // Windowed Qt sample does not implement OSR scale factors.
+}
+
+std::optional<float> RootWindowQt::GetDeviceScaleFactor() const {
+  REQUIRE_MAIN_THREAD();
+  return std::nullopt;
+}
+
+CefRefPtr<CefBrowser> RootWindowQt::GetBrowser() const {
+  REQUIRE_MAIN_THREAD();
+  if (browser_window_) {
+    return browser_window_->GetBrowser();
+  }
+  return nullptr;
+}
+
+ClientWindowHandle RootWindowQt::GetWindowHandle() const {
+  REQUIRE_MAIN_THREAD();
+  return window_;
+}
+
+bool RootWindowQt::WithWindowlessRendering() const {
+  REQUIRE_MAIN_THREAD();
+  DCHECK(initialized_);
+  return false;
+}
+
+void RootWindowQt::CreateBrowserWindow(const std::string& startup_url) {
+  browser_window_.reset(
+      new BrowserWindowStdQt(this, with_controls_, startup_url));
+}
+
+void RootWindowQt::BuildChromeUi() {
+  if (!with_controls_) {
+    return;
+  }
+
+  // Tests menu.
+  QMenu* tests = window_->menuBar()->addMenu(QStringLiteral("Tests"));
+  auto add_test = [this, tests](const char* label, int id) {
+    QAction* action = tests->addAction(QString::fromUtf8(label));
+    QObject::connect(action, &QAction::triggered, window_,
+                     [this, id]() { OnTestAction(id); });
+  };
+  add_test("Get Source", ID_TESTS_GETSOURCE);
+  add_test("Get Text", ID_TESTS_GETTEXT);
+  add_test("New Window", ID_TESTS_WINDOW_NEW);
+  add_test("Popup Window", ID_TESTS_WINDOW_POPUP);
+  add_test("Request", ID_TESTS_REQUEST);
+  add_test("Zoom In", ID_TESTS_ZOOM_IN);
+  add_test("Zoom Out", ID_TESTS_ZOOM_OUT);
+  add_test("Zoom Reset", ID_TESTS_ZOOM_RESET);
+  add_test("Print", ID_TESTS_PRINT);
+  add_test("Print to PDF", ID_TESTS_PRINT_TO_PDF);
+  add_test("Other Tests", ID_TESTS_OTHER_TESTS);
+  menubar_height_ = window_->menuBar()->sizeHint().height();
+
+  toolbar_ = window_->addToolBar(QStringLiteral("Navigation"));
+  toolbar_->setMovable(false);
+
+  back_action_ = toolbar_->addAction(QStringLiteral("Back"));
+  QObject::connect(back_action_, &QAction::triggered, window_,
+                   [this]() { OnBack(); });
+  forward_action_ = toolbar_->addAction(QStringLiteral("Forward"));
+  QObject::connect(forward_action_, &QAction::triggered, window_,
+                   [this]() { OnForward(); });
+  reload_action_ = toolbar_->addAction(QStringLiteral("Reload"));
+  QObject::connect(reload_action_, &QAction::triggered, window_,
+                   [this]() { OnReload(); });
+  stop_action_ = toolbar_->addAction(QStringLiteral("Stop"));
+  QObject::connect(stop_action_, &QAction::triggered, window_,
+                   [this]() { OnStop(); });
+
+  url_entry_ = new QLineEdit(window_);
+  toolbar_->addWidget(url_entry_);
+  QObject::connect(url_entry_, &QLineEdit::returnPressed, window_,
+                   [this]() { OnUrlEnter(); });
+
+  toolbar_height_ = toolbar_->sizeHint().height();
+}
+
+void RootWindowQt::CreateRootWindow(const CefBrowserSettings& settings,
+                                    bool /*initially_hidden*/) {
+  REQUIRE_MAIN_THREAD();
+  DCHECK(!window_);
+
+  int width = start_rect_.IsEmpty() ? 800 : start_rect_.width;
+  int height = start_rect_.IsEmpty() ? 600 : start_rect_.height;
+  int x = start_rect_.x;
+  int y = start_rect_.y;
+
+  window_ = new QMainWindow();
+  window_->setAttribute(Qt::WA_DeleteOnClose, false);
+  window_->setWindowTitle(QStringLiteral("cefclient (Qt)"));
+  window_->resize(width, height);
+  if (always_on_top_) {
+    window_->setWindowFlag(Qt::WindowStaysOnTopHint, true);
+  }
+
+  browser_host_ = new QWidget(window_);
+  browser_host_->setAttribute(Qt::WA_NativeWindow, true);
+  browser_host_->setAttribute(Qt::WA_DontCreateNativeAncestors, true);
+  window_->setCentralWidget(browser_host_);
+
+  BuildChromeUi();
+
+  auto* filter = new RootWindowEventFilter(this);
+  filter->setParent(window_);
+  window_->installEventFilter(filter);
+
+  // Show so native X11 windows exist before CreateBrowser.
+  Show(ShowNormal);
+  if (!start_rect_.IsEmpty()) {
+    window_->move(x, y);
+  }
+
+  // Provide XDisplay for reparent/bounds.
+  XDisplay* xdisplay = cef_get_xdisplay();
+  CHECK(xdisplay);
+  static_cast<BrowserWindowStdQt*>(browser_window_.get())
+      ->set_xdisplay(xdisplay);
+
+  // Initial browser bounds = full host widget.
+  const QSize host_size = browser_host_->size();
+  browser_bounds_ = CefRect(0, 0, host_size.width(), host_size.height());
+
+  if (!is_popup_) {
+    browser_window_->CreateBrowser(browser_host_, browser_bounds_, settings,
+                                   nullptr, delegate_->GetRequestContext());
+  } else {
+    browser_window_->ShowPopup(browser_host_, browser_bounds_.x,
+                               browser_bounds_.y, browser_bounds_.width,
+                               browser_bounds_.height);
+  }
+
+  window_created_ = true;
+}
+
+void RootWindowQt::OnBrowserCreated(CefRefPtr<CefBrowser> browser) {
+  REQUIRE_MAIN_THREAD();
+  if (is_popup_) {
+    CreateRootWindow(CefBrowserSettings(), false);
+  }
+}
+
+void RootWindowQt::OnBrowserWindowClosing() {
+  if (!CefCurrentlyOn(TID_UI)) {
+    CefPostTask(TID_UI,
+                base::BindOnce(&RootWindowQt::OnBrowserWindowClosing, this));
+    return;
+  }
+  is_closing_ = true;
+}
+
+void RootWindowQt::OnBrowserWindowDestroyed() {
+  REQUIRE_MAIN_THREAD();
+  browser_window_.reset();
+  if (!window_destroyed_) {
+    Close(true);
+  }
+  NotifyDestroyedIfDone(false, true);
+}
+
+void RootWindowQt::OnSetAddress(const std::string& url) {
+  REQUIRE_MAIN_THREAD();
+  if (url_entry_) {
+    url_entry_->setText(QString::fromStdString(url));
+  }
+}
+
+void RootWindowQt::OnSetTitle(const std::string& title) {
+  REQUIRE_MAIN_THREAD();
+  if (window_) {
+    window_->setWindowTitle(QString::fromStdString(title));
+  }
+}
+
+void RootWindowQt::OnSetFullscreen(bool fullscreen) {
+  REQUIRE_MAIN_THREAD();
+  if (!window_) {
+    return;
+  }
+  if (fullscreen) {
+    window_->showMaximized();
+  } else {
+    window_->showNormal();
+  }
+}
+
+void RootWindowQt::OnAutoResize(const CefSize& new_size) {
+  REQUIRE_MAIN_THREAD();
+  if (window_) {
+    window_->resize(new_size.width, new_size.height);
+  }
+}
+
+void RootWindowQt::OnSetLoadingState(bool isLoading,
+                                     bool canGoBack,
+                                     bool canGoForward) {
+  REQUIRE_MAIN_THREAD();
+  if (!with_controls_) {
+    return;
+  }
+  if (stop_action_) {
+    stop_action_->setEnabled(isLoading);
+  }
+  if (reload_action_) {
+    reload_action_->setEnabled(!isLoading);
+  }
+  if (back_action_) {
+    back_action_->setEnabled(canGoBack);
+  }
+  if (forward_action_) {
+    forward_action_->setEnabled(canGoForward);
+  }
+}
+
+void RootWindowQt::OnSetDraggableRegions(
+    const std::vector<CefDraggableRegion>& /*regions*/) {
+  REQUIRE_MAIN_THREAD();
+}
+
+bool RootWindowQt::GetRootWindowScreenRect(CefRect& rect) {
+  CEF_REQUIRE_UI_THREAD();
+  if (!window_) {
+    return false;
+  }
+  const QRect g = window_->frameGeometry();
+  rect = CefRect(g.x(), g.y(), g.width(), g.height());
+  return true;
+}
+
+void RootWindowQt::NotifyMoveOrResizeStarted() {
+  REQUIRE_MAIN_THREAD();
+  if (auto browser = GetBrowser()) {
+    browser->GetHost()->NotifyMoveOrResizeStarted();
+  }
+}
+
+void RootWindowQt::NotifySetFocus() {
+  REQUIRE_MAIN_THREAD();
+  if (!browser_window_) {
+    return;
+  }
+  browser_window_->SetFocus(true);
+  delegate_->OnRootWindowActivated(this);
+}
+
+void RootWindowQt::NotifyVisibilityChange(bool show) {
+  REQUIRE_MAIN_THREAD();
+  if (!browser_window_) {
+    return;
+  }
+  if (show) {
+    browser_window_->Show();
+  } else {
+    browser_window_->Hide();
+  }
+}
+
+void RootWindowQt::NotifyContentBounds(int x, int y, int width, int height) {
+  if (!CURRENTLY_ON_MAIN_THREAD()) {
+    MAIN_POST_CLOSURE(base::BindOnce(&RootWindowQt::NotifyContentBounds, this,
+                                     x, y, width, height));
+    return;
+  }
+
+  browser_bounds_ = CefRect(x, y, width, height);
+  if (browser_window_) {
+    browser_window_->SetBounds(x, y, width, height);
+  }
+}
+
+void RootWindowQt::NotifyLoadURL(const std::string& url) {
+  REQUIRE_MAIN_THREAD();
+  CefRefPtr<CefBrowser> browser = GetBrowser();
+  if (browser) {
+    browser->GetMainFrame()->LoadURL(url);
+  }
+}
+
+void RootWindowQt::NotifyButtonClicked(int id) {
+  REQUIRE_MAIN_THREAD();
+  CefRefPtr<CefBrowser> browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  switch (id) {
+    case IDC_NAV_BACK:
+      browser->GoBack();
+      break;
+    case IDC_NAV_FORWARD:
+      browser->GoForward();
+      break;
+    case IDC_NAV_RELOAD:
+      browser->Reload();
+      break;
+    case IDC_NAV_STOP:
+      browser->StopLoad();
+      break;
+    default:
+      NOTREACHED() << "id=" << id;
+  }
+}
+
+void RootWindowQt::NotifyMenuItem(int id) {
+  REQUIRE_MAIN_THREAD();
+  if (delegate_) {
+    delegate_->OnTest(this, id);
+  }
+}
+
+void RootWindowQt::NotifyForceClose() {
+  REQUIRE_MAIN_THREAD();
+  force_close_ = true;
+}
+
+void RootWindowQt::NotifyCloseBrowser() {
+  REQUIRE_MAIN_THREAD();
+  CefRefPtr<CefBrowser> browser = GetBrowser();
+  if (browser) {
+    browser->GetHost()->CloseBrowser(false);
+  }
+}
+
+void RootWindowQt::NotifyDestroyedIfDone(bool window_destroyed,
+                                         bool browser_destroyed) {
+  DCHECK_EQ(1, window_destroyed + browser_destroyed);
+
+  if (!CURRENTLY_ON_MAIN_THREAD()) {
+    MAIN_POST_CLOSURE(base::BindOnce(&RootWindowQt::NotifyDestroyedIfDone, this,
+                                     window_destroyed, browser_destroyed));
+    return;
+  }
+
+  if (window_destroyed) {
+    window_destroyed_ = true;
+  }
+  if (browser_destroyed) {
+    browser_destroyed_ = true;
+  }
+
+  if (window_destroyed_ && browser_destroyed_) {
+    if (window_) {
+      delete window_;
+      window_ = nullptr;
+      browser_host_ = nullptr;
+      toolbar_ = nullptr;
+      url_entry_ = nullptr;
+    }
+    delegate_->OnRootWindowDestroyed(this);
+  }
+}
+
+void RootWindowQt::OnBack() {
+  NotifyButtonClicked(IDC_NAV_BACK);
+}
+void RootWindowQt::OnForward() {
+  NotifyButtonClicked(IDC_NAV_FORWARD);
+}
+void RootWindowQt::OnReload() {
+  NotifyButtonClicked(IDC_NAV_RELOAD);
+}
+void RootWindowQt::OnStop() {
+  NotifyButtonClicked(IDC_NAV_STOP);
+}
+
+void RootWindowQt::OnUrlEnter() {
+  if (url_entry_) {
+    NotifyLoadURL(url_entry_->text().toStdString());
+  }
+}
+
+void RootWindowQt::OnTestAction(int id) {
+  NotifyMenuItem(id);
+}
+
+bool RootWindowQt::ShouldAcceptClose() {
+  REQUIRE_MAIN_THREAD();
+  if (force_close_ || is_closing_) {
+    return true;
+  }
+  // Ask the browser to close first (onbeforeunload, etc.).
+  NotifyCloseBrowser();
+  return false;
+}
+
+void RootWindowQt::NotifyWindowDestroyed() {
+  NotifyDestroyedIfDone(true, false);
+}
+
+void RootWindowQt::OnCloseRequested() {
+  // Kept for API symmetry with the header; close path uses ShouldAcceptClose.
+  (void)ShouldAcceptClose();
+}
+
+void RootWindowQt::OnWindowResized() {
+  REQUIRE_MAIN_THREAD();
+  if (!browser_host_) {
+    return;
+  }
+  const QSize s = browser_host_->size();
+  NotifyContentBounds(0, 0, s.width(), s.height());
+  NotifyMoveOrResizeStarted();
+}
+
+void RootWindowQt::OnWindowFocused() {
+  REQUIRE_MAIN_THREAD();
+  NotifySetFocus();
+}
+
+}  // namespace client
