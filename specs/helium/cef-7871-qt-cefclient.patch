+// Event filter that forwards resize/close/focus from the QMainWindow.
+class RootWindowEventFilter : public QObject {
+ public:
+  explicit RootWindowEventFilter(RootWindowQt* owner) : owner_(owner) {}
+
+  bool eventFilter(QObject* watched, QEvent* event) override {
+    switch (event->type()) {
+      case QEvent::Resize:
+      case QEvent::Move:
+        owner_->OnWindowResized();
+        break;
+      case QEvent::Close: {
+        // Returns true if the close should proceed.
+        if (!owner_->ShouldAcceptClose()) {
+          event->ignore();
+          return true;  // Filter (block) the close.
+        }
+        // Allow destruction path.
+        QObject::connect(watched, &QObject::destroyed, watched, [this]() {
+          owner_->NotifyWindowDestroyed();
+        });
+        break;
+      }
+      case QEvent::WindowActivate:
+        owner_->OnWindowFocused();
+        break;
+      default:
+        break;
+    }
+    return QObject::eventFilter(watched, event);
+  }
+
+ private:
+  RootWindowQt* owner_;
+};
