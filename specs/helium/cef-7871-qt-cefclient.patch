+#include "tests/cefclient/browser/main_message_loop_multithreaded_qt.h"
+
+#include <QApplication>
+#include <QTimer>
+
+#include "include/base/cef_logging.h"
+
+namespace client {
+
+MainMessageLoopMultithreadedQt::MainMessageLoopMultithreadedQt()
+    : thread_id_(base::PlatformThread::CurrentId()) {}
+
+MainMessageLoopMultithreadedQt::~MainMessageLoopMultithreadedQt() {
+  DCHECK(RunsTasksOnCurrentThread());
+  DCHECK(queued_tasks_.empty());
+}
+
+int MainMessageLoopMultithreadedQt::Run() {
+  DCHECK(RunsTasksOnCurrentThread());
+  running_ = true;
+
+  QTimer timer;
+  QObject::connect(&timer, &QTimer::timeout, &timer, [this]() { RunTasks(); });
+  timer.start(10);
+
+  const int result = qApp->exec();
+  running_ = false;
+  RunTasks();
+  return result;
+}
+
+void MainMessageLoopMultithreadedQt::Quit() {
+  qApp->quit();
+}
+
+void MainMessageLoopMultithreadedQt::PostTask(CefRefPtr<CefTask> task) {
+  base::AutoLock lock_scope(lock_);
+  queued_tasks_.push(task);
+}
+
+bool MainMessageLoopMultithreadedQt::RunsTasksOnCurrentThread() const {
+  return base::PlatformThread::CurrentId() == thread_id_;
+}
+
+void MainMessageLoopMultithreadedQt::RunTasks() {
+  DCHECK(RunsTasksOnCurrentThread());
+  for (;;) {
+    CefRefPtr<CefTask> task;
+    {
+      base::AutoLock lock_scope(lock_);
+      if (queued_tasks_.empty()) {
+        break;
+      }
+      task = queued_tasks_.front();
+      queued_tasks_.pop();
+    }
+    task->Execute();
+  }
+}
+
+}  // namespace client
