+    CefRefPtr<CefBrowser> /*browser*/,
+    const CefString& /*document_name*/,
+    const CefString& /*pdf_file_path*/,
+    CefRefPtr<CefPrintJobCallback> /*callback*/) {
+  CEF_REQUIRE_UI_THREAD();
+  return false;
+}
+
+void ClientPrintHandlerQt::OnPrintReset(CefRefPtr<CefBrowser> /*browser*/) {}
+
+CefSize ClientPrintHandlerQt::GetPdfPaperSize(
+    CefRefPtr<CefBrowser> /*browser*/,
+    int device_units_per_inch) {
+  CEF_REQUIRE_UI_THREAD();
+  QPrinter printer;
+  const QSizeF inches =
+      printer.pageLayout().pageSize().size(QPageSize::Inch);
+  return CefSize(static_cast<int>(inches.width() * device_units_per_inch),
+                 static_cast<int>(inches.height() * device_units_per_inch));
+}
