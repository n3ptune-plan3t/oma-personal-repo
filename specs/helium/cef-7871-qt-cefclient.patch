+QWidget* GetWindow(CefRefPtr<CefBrowser> browser) {
+  scoped_refptr<RootWindow> root_window =
+      RootWindow::GetForBrowser(browser->GetIdentifier());
+  if (root_window) {
+    return root_window->GetWindowHandle();
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+WindowTestRunnerQt::WindowTestRunnerQt() = default;
+
+void WindowTestRunnerQt::Minimize(CefRefPtr<CefBrowser> browser) {
+  REQUIRE_MAIN_THREAD();
+  if (auto* window = GetWindow(browser)) {
+    window->showMinimized();
+  }
+}
+
+void WindowTestRunnerQt::Maximize(CefRefPtr<CefBrowser> browser) {
+  REQUIRE_MAIN_THREAD();
+  if (auto* window = GetWindow(browser)) {
+    window->showMaximized();
+  }
+}
+
+void WindowTestRunnerQt::Restore(CefRefPtr<CefBrowser> browser) {
+  REQUIRE_MAIN_THREAD();
+  if (auto* window = GetWindow(browser)) {
+    window->showNormal();
+  }
+}
