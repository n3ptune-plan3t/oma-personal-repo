+void ClientPrintHandlerQt::OnPrintSettings(
+    CefRefPtr<CefBrowser> /*browser*/,
+    CefRefPtr<CefPrintSettings> settings,
+    bool get_defaults) {
+  CEF_REQUIRE_UI_THREAD();
+  if (!get_defaults) {
+    return;
+  }
+  QPrinter printer;
+  const QPageSize size = printer.pageLayout().pageSize();
+  const QSizeF points = size.size(QPageSize::Point);
+  settings->SetOrientation(printer.pageLayout().orientation() ==
+                           QPageLayout::Landscape);
+  settings->SetDeviceName(printer.printerName().toStdString());
+  // Size is applied via GetPdfPaperSize for PDF path.
+  (void)points;
+}
+
+bool ClientPrintHandlerQt::OnPrintDialog(
+    CefRefPtr<CefBrowser> /*browser*/,
+    bool /*has_selection*/,
+    CefRefPtr<CefPrintDialogCallback> callback) {
+  CEF_REQUIRE_UI_THREAD();
+  // Let Chromium/CEF show the system (portal/Qt) print dialog instead.
+  callback->Cancel();
+  return false;
+}
