+QStringList BuildNameFilters(const std::vector<CefString>& accept_filters,
+                             const std::vector<CefString>& accept_extensions,
+                             const std::vector<CefString>& accept_descriptions) {
+  QStringList filters;
+  for (size_t j = 0; j < accept_filters.size(); ++j) {
+    const std::string& filter = accept_filters[j];
+    if (filter.empty()) {
+      continue;
+    }
+
+    std::vector<std::string> extensions =
+        AsciiStrSplit(accept_extensions[j], ';');
+    std::string description = accept_descriptions[j];
+
+    if (extensions.empty()) {
+      std::vector<CefString> ext;
+      CefGetExtensionsForMimeType(filter, ext);
+      for (size_t x = 0; x < ext.size(); ++x) {
+        extensions.push_back("." + ext[x].ToString());
+      }
+    }
+    if (extensions.empty()) {
+      continue;
+    }
+
+    QString patterns;
+    for (size_t x = 0; x < extensions.size(); ++x) {
+      if (x != 0) {
+        patterns += QLatin1Char(' ');
+      }
+      patterns += QLatin1Char('*');
+      patterns += QString::fromStdString(extensions[x]);
+    }
+
+    QString name = QString::fromStdString(description);
+    if (name.isEmpty()) {
+      name = patterns;
+    } else {
+      name = name + QStringLiteral(" (") + patterns + QLatin1Char(')');
+    }
+    filters << name;
+  }
+  if (!filters.isEmpty()) {
+    filters << QStringLiteral("All Files (*)");
+  }
+  return filters;
+}
+
+}  // namespace
+
+ClientDialogHandlerQt::ClientDialogHandlerQt() = default;
+
+bool ClientDialogHandlerQt::OnFileDialog(
+    CefRefPtr<CefBrowser> browser,
+    FileDialogMode mode,
+    const CefString& title,
+    const CefString& default_file_path,
+    const std::vector<CefString>& accept_filters,
+    const std::vector<CefString>& accept_extensions,
+    const std::vector<CefString>& accept_descriptions,
+    CefRefPtr<CefFileDialogCallback> callback) {
+  CEF_REQUIRE_UI_THREAD();
+
+  // Run on the main/UI thread that owns Qt widgets.
+  if (!CURRENTLY_ON_MAIN_THREAD()) {
+    MAIN_POST_CLOSURE(base::BindOnce(
+        [](CefRefPtr<ClientDialogHandlerQt> self,
+           CefRefPtr<CefBrowser> browser, FileDialogMode mode,
+           CefString title, CefString default_file_path,
+           std::vector<CefString> accept_filters,
+           std::vector<CefString> accept_extensions,
+           std::vector<CefString> accept_descriptions,
+           CefRefPtr<CefFileDialogCallback> callback) {
+          self->OnFileDialog(browser, mode, title, default_file_path,
+                             accept_filters, accept_extensions,
+                             accept_descriptions, callback);
+        },
+        CefRefPtr<ClientDialogHandlerQt>(this), browser, mode, title,
+        default_file_path, accept_filters, accept_extensions,
+        accept_descriptions, callback));
+    return true;
+  }
+
+  QWidget* parent = GetParentWidget(browser);
+  QFileDialog dialog(parent);
+  if (!title.empty()) {
+    dialog.setWindowTitle(QString::fromStdString(title.ToString()));
+  }
+
+  const QStringList name_filters =
+      BuildNameFilters(accept_filters, accept_extensions, accept_descriptions);
+  if (!name_filters.isEmpty()) {
+    dialog.setNameFilters(name_filters);
+  }
+
+  const std::string default_path = default_file_path.ToString();
+  if (!default_path.empty()) {
+    dialog.selectFile(QString::fromStdString(default_path));
+  }
+
+  switch (mode) {
+    case FILE_DIALOG_OPEN:
+      dialog.setFileMode(QFileDialog::ExistingFile);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case FILE_DIALOG_OPEN_MULTIPLE:
+      dialog.setFileMode(QFileDialog::ExistingFiles);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case FILE_DIALOG_OPEN_FOLDER:
+      dialog.setFileMode(QFileDialog::Directory);
+      dialog.setOption(QFileDialog::ShowDirsOnly, true);
+      dialog.setAcceptMode(QFileDialog::AcceptOpen);
+      break;
+    case FILE_DIALOG_SAVE:
+      dialog.setFileMode(QFileDialog::AnyFile);
+      dialog.setAcceptMode(QFileDialog::AcceptSave);
+      break;
+    case FILE_DIALOG_NUM_VALUES:
+      break;
+  }
+
+  if (dialog.exec() != QDialog::Accepted) {
+    callback->Cancel();
+    return true;
+  }
+
+  std::vector<CefString> files;
+  for (const QString& path : dialog.selectedFiles()) {
+    files.push_back(path.toStdString());
+  }
+  callback->Continue(files);
+  return true;
+}
+
+bool ClientDialogHandlerQt::OnJSDialog(
+    CefRefPtr<CefBrowser> browser,
+    const CefString& /*origin_url*/,
+    JSDialogType dialog_type,
+    const CefString& message_text,
+    const CefString& default_prompt_text,
+    CefRefPtr<CefJSDialogCallback> callback,
+    bool& suppress_message) {
+  CEF_REQUIRE_UI_THREAD();
+  suppress_message = false;
+
+  if (!CURRENTLY_ON_MAIN_THREAD()) {
+    MAIN_POST_CLOSURE(base::BindOnce(
+        [](CefRefPtr<ClientDialogHandlerQt> self,
+           CefRefPtr<CefBrowser> browser, JSDialogType dialog_type,
+           CefString message_text, CefString default_prompt_text,
+           CefRefPtr<CefJSDialogCallback> callback) {
+          bool suppress = false;
+          self->OnJSDialog(browser, CefString(), dialog_type, message_text,
+                           default_prompt_text, callback, suppress);
+        },
+        CefRefPtr<ClientDialogHandlerQt>(this), browser, dialog_type,
+        message_text, default_prompt_text, callback));
+    return true;
+  }
+
+  QWidget* parent = GetParentWidget(browser);
+  const QString message = QString::fromStdString(message_text.ToString());
+
+  switch (dialog_type) {
+    case JSDIALOGTYPE_ALERT:
+      QMessageBox::information(parent, QStringLiteral("JavaScript Alert"),
+                               message);
+      callback->Continue(true, CefString());
+      break;
+    case JSDIALOGTYPE_CONFIRM: {
+      const auto ret = QMessageBox::question(
+          parent, QStringLiteral("JavaScript Confirm"), message);
+      callback->Continue(ret == QMessageBox::Yes, CefString());
+      break;
+    }
+    case JSDIALOGTYPE_PROMPT: {
+      bool ok = false;
+      const QString text = QInputDialog::getText(
+          parent, QStringLiteral("JavaScript Prompt"), message,
+          QLineEdit::Normal,
+          QString::fromStdString(default_prompt_text.ToString()), &ok);
+      callback->Continue(ok, text.toStdString());
+      break;
+    }
+  }
+  return true;
+}
+
+bool ClientDialogHandlerQt::OnBeforeUnloadDialog(
+    CefRefPtr<CefBrowser> browser,
+    const CefString& message_text,
+    bool /*is_reload*/,
+    CefRefPtr<CefJSDialogCallback> callback) {
+  CEF_REQUIRE_UI_THREAD();
+
+  if (!CURRENTLY_ON_MAIN_THREAD()) {
+    MAIN_POST_CLOSURE(base::BindOnce(
+        [](CefRefPtr<ClientDialogHandlerQt> self,
+           CefRefPtr<CefBrowser> browser, CefString message_text,
+           CefRefPtr<CefJSDialogCallback> callback) {
+          self->OnBeforeUnloadDialog(browser, message_text, false, callback);
+        },
+        CefRefPtr<ClientDialogHandlerQt>(this), browser, message_text,
+        callback));
+    return true;
+  }
+
+  QWidget* parent = GetParentWidget(browser);
+  const auto ret = QMessageBox::question(
+      parent, QStringLiteral("Leave site?"),
+      QString::fromStdString(message_text.ToString()));
+  callback->Continue(ret == QMessageBox::Yes, CefString());
+  return true;
+}
+
+void ClientDialogHandlerQt::OnResetDialogState(CefRefPtr<CefBrowser> browser) {
+  CEF_REQUIRE_UI_THREAD();
+}
