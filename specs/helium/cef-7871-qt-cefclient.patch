+
+#include "tests/cefclient/browser/browser_window_std_qt.h"
+
+#include <X11/Xlib.h>
+
+// X11 macros collide with Qt (e.g. Status vs QDataStream::Status).
+#undef Bool
+#undef CursorShape
+#undef Expose
+#undef FocusIn
+#undef FocusOut
+#undef FontChange
+#undef KeyPress
+#undef KeyRelease
+#undef None
+#undef Status
+#undef Success
+#undef Unsorted
+#undef RootWindow
+
